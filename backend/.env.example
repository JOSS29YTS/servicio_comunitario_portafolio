# ==============================
# VARIABLES DE ENTORNO
# Copia este archivo como .env y
# rellena con tus valores reales
# ==============================

# Servidor
PORT=3001
NODE_ENV=development

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=repositorio_academico
DB_USER=root
DB_PASSWORD=tu_contraseña_aqui

# JWT
JWT_SECRET=colegio_fatima_jwt_secret_2024_cambiar_en_produccion
JWT_EXPIRES_IN=8h

# Archivos PDF
UPLOADS_DIR=uploads
MAX_FILE_SIZE_MB=20

# CORS (URL del frontend)
FRONTEND_URL=http://localhost:5173

# ==============================
# DISASTER RECOVERY & GOOGLE DRIVE
# ==============================
# Para simulación, usa: colfatima_secret_api_key_2026_placeholder
GDRIVE_API_KEY_TEMP=colfatima_secret_api_key_2026_placeholder
GDRIVE_CLIENT_ID=tu_gdrive_client_id_produccion
GDRIVE_CLIENT_SECRET=tu_gdrive_client_secret_produccion
GDRIVE_REFRESH_TOKEN=tu_gdrive_refresh_token_produccion
GDRIVE_FOLDER_ID=tu_gdrive_folder_id_produccion_opcional

# ==============================
# IA & AUTOMATIZACIÓN (GEMINI API)
# ==============================
# Para simulación, usa: gemini_key_simulacion_2026_placeholder
GEMINI_API_KEY=gemini_key_simulacion_2026_placeholder
GEMINI_MODEL=gemini-2.0-flash


